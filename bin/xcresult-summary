#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_lib.sh"

load_apple_env

PATH_ARG="${1:-}"
if [[ -n "$PATH_ARG" ]]; then
  RESULT_PATH="$PATH_ARG"
else
  RESULT_PATH="$(latest_xcresult || true)"
fi

if [[ -z "$RESULT_PATH" || ! -d "$RESULT_PATH" ]]; then
  echo "No xcresult bundle found."
  exit 1
fi

echo "xcresult: $RESULT_PATH"
echo

if xcrun xcresulttool get test-results summary --path "$RESULT_PATH" >/dev/null 2>&1; then
  xcrun xcresulttool get test-results summary --path "$RESULT_PATH"
  exit 0
fi

if xcrun xcresulttool get --format json --path "$RESULT_PATH" > /tmp/xcresult-summary.json 2>/dev/null; then
  if command -v jq >/dev/null 2>&1; then
    jq '
      [
        .. | objects | select(has("issueType") or has("message"))
      ]
      | map({
          issueType: (.issueType?._value // .issueType // "unknown"),
          message: (.message?._value // .message // .title?._value // .localizedDescription?._value // empty)
        })
      | map(select(.message != ""))
      | unique
    ' /tmp/xcresult-summary.json
  else
    head -n 200 /tmp/xcresult-summary.json
  fi
  rm -f /tmp/xcresult-summary.json
  exit 0
fi

echo "Could not summarize xcresult with xcresulttool."
echo "Open in Xcode if needed:"
echo "  open \"$RESULT_PATH\""
