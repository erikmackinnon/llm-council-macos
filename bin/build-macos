#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_lib.sh"

load_apple_env
SCHEME="${MACOS_SCHEME:-$XCODE_SCHEME}"

run_xcodebuild "build-macos" \
  "${CONTAINER_ARGS[@]}" \
  -scheme "${SCHEME}" \
  -configuration "${XCODE_CONFIGURATION}" \
  -destination "$(macos_destination)" \
  build
