#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_lib.sh"

load_apple_env

if ! command -v periphery >/dev/null 2>&1; then
  echo "periphery is not installed."
  exit 1
fi

if [[ -n "${XCODE_WORKSPACE:-}" ]]; then
  periphery scan --workspace "$XCODE_WORKSPACE" --schemes "$XCODE_SCHEME" --format xcode
elif [[ -n "${XCODE_PROJECT:-}" ]]; then
  periphery scan --project "$XCODE_PROJECT" --schemes "$XCODE_SCHEME" --format xcode
else
  echo "Missing XCODE_WORKSPACE / XCODE_PROJECT in .codex/apple.env"
  exit 1
fi
